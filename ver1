<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Anniversary!</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        body {
            font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #fdfbf7;
            color: #4a4a4a;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }
        .container {
            background-color: #ffffff;
            border-radius: 20px;
            padding: 40px 30px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            text-align: center;
            max-width: 450px;
            width: 100%;
        }
        .heart {
            font-size: 48px;
            margin-bottom: 10px;
            animation: pulse 1.5s infinite;
        }
        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.15); }
            100% { transform: scale(1); }
        }
        h1 {
            font-size: 24px;
            color: #d86975;
            margin-bottom: 8px;
        }
        .names {
            font-size: 18px;
            font-weight: 600;
            color: #777;
            margin-bottom: 25px;
        }
        .dday-box {
            background-color: #fff5f6;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 25px;
        }
        .dday-title {
            font-size: 14px;
            color: #d86975;
            margin-bottom: 5px;
        }
        .dday-count {
            font-size: 36px;
            font-weight: bold;
            color: #d86975;
        }
        .message {
            line-height: 1.7;
            font-size: 15px;
            color: #555;
            word-break: keep-all;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="heart">❤️</div>
    <h1>행복한 결혼기념일</h1>
    <div class="names">OO & OO</div>

    <div class="dday-box">
        <div class="dday-title">결혼하신지</div>
        <div class="dday-count" id="dday">D+0</div>
    </div>

    <p class="message">
        29주년을 진심으로 축하드리며 <br>
        앞으로 함께할 날들도 늘 지금처럼 사랑하고 행복하길! ✨
    </p>
</div>

<script>
    // ⚠️ 여기에 결혼식 날짜를 입력하세요 (연도-월-일)
    const weddingDate = new Date("1998-11-09");

    function updateDDay() {
        const today = new Date();
        // 날짜 간격 계산
        const diffTime = today - weddingDate;
        const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24)) + 1;

        document.getElementById("dday").innerText = `D+${diffDays}일`;
    }

    updateDDay();
</script>

</body>
</html>
